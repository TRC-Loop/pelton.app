---
import Icon from './Icon.astro'
import AnchorHeading from './AnchorHeading.astro'
import { repo } from '../data/site.js'
---

<section class="download" id="download">
  <div class="wrap">
    <div class="section-head">
      <AnchorHeading id="download">Download Pelton</AnchorHeading>
      <p>
        Every release ships unsigned builds for macOS, Windows and Linux, the last as a .deb, an .rpm
        and a plain amd64 binary. First launch needs one extra step on macOS and Windows, since the
        builds are not code-signed.
      </p>
    </div>

    <div class="dl-card">
      <div class="dl-primary">
        <h3 id="dl-title">Get the latest release</h3>
        <p id="dl-sub">Detecting your platform and the newest build.</p>
      </div>
      <div class="dl-buttons">
        <a class="btn accent" id="dl-primary" href={repo.releasesLatest} data-gated target="_blank" rel="noreferrer noopener">
          <span class="dl-icon" data-icon="download"><Icon name="download" size={18} /></span>
          <span class="dl-icon" data-icon="mac" hidden><Icon name="apple" size={18} /></span>
          <span class="dl-icon" data-icon="win" hidden><Icon name="brand-windows" size={18} /></span>
          <span class="dl-icon" data-icon="linux" hidden><Icon name="brand-redhat" size={18} /></span>
          <span id="dl-primary-label">Latest release</span>
        </a>
        <a class="btn ghost" href={repo.releases} target="_blank" rel="noreferrer noopener">
          <Icon name="external-link" size={17} />
          <span>All builds and releases</span>
        </a>
      </div>
    </div>

    <!-- a user agent cannot tell Debian from Fedora, so on Linux we list the formats
         instead of guessing one -->
    <div class="dl-alts" id="dl-alts" hidden>
      <span class="dl-alts-label">Other Linux formats</span>
      <div class="dl-alts-links">
        <a id="dl-alt-deb" href={repo.releasesLatest} data-gated target="_blank" rel="noreferrer noopener">
          <Icon name="package" size={15} />
          <span>.deb <span class="dl-alt-hint">Debian, Ubuntu</span></span>
        </a>
        <a id="dl-alt-rpm" href={repo.releasesLatest} data-gated target="_blank" rel="noreferrer noopener">
          <Icon name="package" size={15} />
          <span>.rpm <span class="dl-alt-hint">Fedora</span></span>
        </a>
        <a id="dl-alt-bin" href={repo.releasesLatest} data-gated target="_blank" rel="noreferrer noopener">
          <Icon name="terminal" size={15} />
          <span>Binary <span class="dl-alt-hint">amd64</span></span>
        </a>
        <a href={repo.copr} target="_blank" rel="noreferrer noopener">
          <Icon name="brand-redhat" size={15} />
          <span>Copr <span class="dl-alt-hint">{repo.coprEnable}</span></span>
        </a>
      </div>
    </div>

    <!-- nightly builds. deliberately understated and pointed at the GitHub
         release page rather than at a file: that page carries the full warning,
         and nobody should reach a nightly installer in a single click. -->
    <div class="dl-nightly">
      <div class="dl-nightly-text">
        <h3>Looking for nightly builds?</h3>
        <p>
          Automated builds of the development branch, published on days there are changes. They are
          untested, expected to break, and can lose or damage email. Do not use one with your real
          inbox.
        </p>
      </div>
      <a class="btn ghost" id="dl-nightly-link" href={repo.releases} target="_blank" rel="noreferrer noopener">
        <Icon name="alert-triangle" size={17} />
        <span>View the latest nightly</span>
      </a>
    </div>
  </div>

  <dialog class="dl-modal" id="dl-modal" aria-labelledby="dl-modal-title">
    <h3 id="dl-modal-title">Before you download</h3>
    <p id="dl-modal-body">
      Pelton is free software under the GPL-3.0. It comes without any warranty and you use it at
      your own risk. It connects to your real mailboxes, deletions can be permanent, and Pelton is
      not a backup tool. Keep your own backup of anything you cannot afford to lose.
    </p>
    <p class="dl-modal-links">
      <a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank" rel="noreferrer noopener">GPL-3.0</a>
      <span>&middot;</span>
      <a href="/terms" target="_blank" rel="noreferrer noopener" id="dl-modal-terms">Terms and liability</a>
    </p>
    <label class="dl-modal-check">
      <input type="checkbox" id="dl-modal-accept" />
      <span id="dl-modal-check-label">I have read and accept the terms and the liability notice.</span>
    </label>
    <div class="dl-modal-actions">
      <button type="button" class="btn ghost" id="dl-modal-cancel">Cancel</button>
      <button type="button" class="btn accent" id="dl-modal-confirm" disabled>Download</button>
    </div>
  </dialog>
</section>

<script>
  const API = 'https://api.github.com/repos/TRC-Loop/Pelton/releases/latest'
  const FALLBACK = 'https://github.com/TRC-Loop/Pelton/releases/latest'
  const RELEASES_API = 'https://api.github.com/repos/TRC-Loop/Pelton/releases?per_page=20'

  const matchers: Record<string, RegExp> = {
    'mac-arm': /macos-applesilicon\.dmg$/i,
    'mac-intel': /macos-intel\.dmg$/i,
    win: /windows-amd64-installer\.exe$/i,
    linux: /linux-amd64\.deb$/i,
    deb: /linux-amd64\.deb$/i,
    rpm: /linux-fedora.*\.rpm$/i,
    bin: /linux-amd64$/i,
  }

  const labels: Record<string, string> = {
    'mac-arm': 'macOS (Apple Silicon)',
    'mac-intel': 'macOS (Intel)',
    win: 'Windows',
    linux: 'Linux (.deb)',
  }

  async function detectMac(): Promise<'mac-arm' | 'mac-intel'> {
    const uaData = (navigator as any).userAgentData
    if (uaData?.getHighEntropyValues) {
      try {
        const v = await uaData.getHighEntropyValues(['architecture'])
        if (v.architecture === 'arm') return 'mac-arm'
        if (v.architecture === 'x86') return 'mac-intel'
      } catch {}
    }
    return 'mac-arm'
  }

  async function detectPlatform(): Promise<string | null> {
    const ua = navigator.userAgent
    if (/Android/i.test(ua)) return null
    if (/Mac/i.test(ua) && !/iPhone|iPad|iPod/i.test(ua)) return await detectMac()
    if (/Win/i.test(ua)) return 'win'
    if (/Linux/i.test(ua)) return 'linux'
    return null
  }

  function setText(id: string, text: string): void {
    const el = document.getElementById(id)
    if (el) el.textContent = text
  }

  async function run(): Promise<void> {
    const platform = await detectPlatform()

    let assets: { name: string; browser_download_url: string }[] = []
    let version = ''
    try {
      const res = await fetch(API, { headers: { Accept: 'application/vnd.github+json' } })
      if (res.ok) {
        const data = await res.json()
        assets = data.assets || []
        version = data.tag_name || data.name || ''
      }
    } catch {}

    const urlFor = (key: string): string | null => {
      const m = matchers[key]
      const asset = assets.find((a) => m.test(a.name))
      return asset ? asset.browser_download_url : null
    }

    if (version) {
      setText('dl-title', `Pelton ${version}`)
    }
    setText('dl-sub', version
      ? 'The newest build, straight from GitHub releases.'
      : 'Open the latest release on GitHub to pick your build.')

    const primary = document.getElementById('dl-primary') as HTMLAnchorElement | null
    if (platform) {
      const url = urlFor(platform)
      setText('dl-primary-label', `Download for ${labels[platform]}`)
      if (primary) primary.href = url || FALLBACK

      const iconKey = platform.startsWith('mac') ? 'mac' : platform === 'win' ? 'win' : 'linux'
      for (const el of document.querySelectorAll<HTMLElement>('.dl-icon')) {
        el.hidden = el.dataset.icon !== iconKey
      }
    }

    // only Linux users need the format picker
    if (platform === 'linux') {
      const alts = document.getElementById('dl-alts')
      if (alts) alts.hidden = false
      for (const [key, id] of [['deb', 'dl-alt-deb'], ['rpm', 'dl-alt-rpm'], ['bin', 'dl-alt-bin']]) {
        const url = urlFor(key)
        const el = document.getElementById(id) as HTMLAnchorElement | null
        if (el && url) el.href = url
      }
    }
  }

  const de = {
    title: 'Vor dem Download',
    body:
      'Pelton ist freie Software unter der GPL-3.0. Die Bereitstellung erfolgt ohne ' +
      'Gewährleistung, die Nutzung auf eigene Gefahr. Pelton greift auf deine echten ' +
      'Postfächer zu, Löschvorgänge können endgültig sein, und Pelton ist kein ' +
      'Backup-Werkzeug. Sichere selbst, was du nicht verlieren darfst.',
    terms: 'Nutzungsbedingungen und Haftung',
    check: 'Ich habe die Nutzungsbedingungen und den Haftungsausschluss gelesen und akzeptiere sie.',
    cancel: 'Abbrechen',
    confirm: 'Herunterladen',
  }

  function localizeModal(): void {
    if (!navigator.language.toLowerCase().startsWith('de')) return
    setText('dl-modal-title', de.title)
    setText('dl-modal-body', de.body)
    setText('dl-modal-check-label', de.check)
    setText('dl-modal-cancel', de.cancel)
    setText('dl-modal-confirm', de.confirm)
    const terms = document.getElementById('dl-modal-terms') as HTMLAnchorElement | null
    if (terms) {
      terms.href = '/terms/de'
      terms.textContent = de.terms
    }
  }

  // the disclaimer has to be shown before the file is fetched, so every direct download
  // goes through the dialog and nothing about the confirmation is stored
  function gate(): void {
    const modal = document.getElementById('dl-modal') as HTMLDialogElement | null
    const accept = document.getElementById('dl-modal-accept') as HTMLInputElement | null
    const confirm = document.getElementById('dl-modal-confirm') as HTMLButtonElement | null
    const cancel = document.getElementById('dl-modal-cancel') as HTMLButtonElement | null
    if (!modal || !accept || !confirm || !cancel) return

    localizeModal()
    let pending = ''

    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-gated]')) {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        pending = link.href
        accept.checked = false
        confirm.disabled = true
        modal.showModal()
      })
    }

    accept.addEventListener('change', () => {
      confirm.disabled = !accept.checked
    })

    cancel.addEventListener('click', () => modal.close())

    confirm.addEventListener('click', () => {
      if (!accept.checked || !pending) return
      modal.close()
      window.open(pending, '_blank', 'noopener,noreferrer')
    })
  }

  // point the nightly button at the newest nightly prerelease. /releases/latest
  // skips prereleases by design, so this reads the full list instead. On any
  // failure the button keeps its href, the releases page, which still gets the
  // user there.
  async function nightly(): Promise<void> {
    const link = document.getElementById('dl-nightly-link') as HTMLAnchorElement | null
    if (!link) return
    try {
      const res = await fetch(RELEASES_API, { headers: { Accept: 'application/vnd.github+json' } })
      if (!res.ok) return
      const list = (await res.json()) as { tag_name: string; html_url: string; prerelease: boolean }[]
      const newest = list.find((r) => r.prerelease && r.tag_name.startsWith('nightly-'))
      if (newest) link.href = newest.html_url
    } catch {}
  }

  run()
  gate()
  nightly()
</script>
